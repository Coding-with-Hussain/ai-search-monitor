# =============================================================================
# AI Search Visibility Monitor — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all others are
# server-only.
# =============================================================================

# Public base URL of the app (used in emails, Stripe redirects, sitemap, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth + Postgres) -------------------------------------------------
# Project URL and anon/publishable key: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. Used for account deletion and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by the server (Drizzle). In production use the
# Supabase *transaction pooler* URL (port 6543). Dashboard → Connect → ORMs.
DATABASE_URL=

# --- Stripe (optional in development) ----------------------------------------------
# Without these, billing UI is shown but checkout is disabled with an explanation.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of your webhook endpoint (/api/stripe/webhook). `stripe listen` prints one locally.
STRIPE_WEBHOOK_SECRET=
# Optional explicit price IDs. If unset, prices are resolved by lookup key
# (aivm_<plan>_monthly / aivm_<plan>_yearly) — `npm run stripe:setup` creates them.
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_GROWTH_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_AGENCY_YEARLY=
# Optional Customer Portal configuration id (`npm run stripe:setup` prints one).
# STRIPE_PORTAL_CONFIGURATION_ID=

# --- AI providers (server-only) ------------------------------------------------------
# Only needed when AI_VISIBILITY_MOCK_MODE=false. Missing providers are marked
# "unavailable" in scans instead of failing the whole scan.
OPENAI_API_KEY=
# Model used for ChatGPT monitoring (Responses API). Web search adds citations.
OPENAI_MODEL=gpt-5-mini
OPENAI_WEB_SEARCH=true
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Response analysis: auto = LLM analyzer for live answers when OPENAI_API_KEY is
# set (validated + reconciled with deterministic checks), heuristic otherwise.
ANALYSIS_MODE=auto
ANALYSIS_MODEL=gpt-5-mini

# --- Simulation / cost control -----------------------------------------------------
# true = deterministic simulated AI answers (no API calls, labelled "Simulation").
AI_VISIBILITY_MOCK_MODE=true
# Artificial latency per simulated call so progress UI behaves like a real scan.
MOCK_LATENCY_MS=250
# Hard cap on provider calls per scan (queries × providers).
MAX_PROVIDER_CALLS_PER_SCAN=600
# Parallel provider calls per scan worker.
SCAN_CONCURRENCY=4
# Public free checker: false = always simulated. true = live calls (rate-limited).
FREE_CHECK_LIVE=false
# Global daily cap on free checks (all visitors combined).
FREE_CHECK_DAILY_LIMIT=100

# --- Background jobs -------------------------------------------------------------------
# Shared secret for cron endpoints (/api/cron/*). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Optional Inngest. When unset, scans run in-process after the request (local fallback)
# and the cron worker resumes anything unfinished.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to true when running the Inngest dev server locally.
INNGEST_DEV=false

# --- Email (optional) --------------------------------------------------------------------
# Resend API key for weekly reports and alerts. Without it, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM="AI Visibility <reports@yourdomain.com>"

# --- Analytics (optional) ------------------------------------------------------------------
# PostHog project key; when unset, events are logged in development only.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Misc ------------------------------------------------------------------------------------
# Dev tools (/admin) are always on in development. In production they also need
# an admin user (profiles.is_admin = true).
ENABLE_DEV_TOOLS=false
LOG_LEVEL=info
